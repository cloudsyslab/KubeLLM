from http.server import SimpleHTTPRequestHandler, HTTPServer

time.sleep(2)  # Simulate slow startup

class Handler(SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.end_headers()
