         ing/wrong_port_5000"; CONTEXT=$(kubectl config current-context         
         2>/dev/null || echo ""); if echo "$CONTEXT" | grep -qi minikube; then  
         PROFILE=${MINIKUBE_PROFILE:-$CONTEXT}; minikube -p "$PROFILE" image    
         build -t "$IMAGE" -f "$DOCKERDIR/Dockerfile" "$DOCKERDIR"; else docker 
