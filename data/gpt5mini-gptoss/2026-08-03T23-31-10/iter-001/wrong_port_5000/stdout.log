         kubectl delete pod kube-wrong-port-5000 --ignore-not-found && kubectl  
         apply -f                                                               
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/wrong_p
         ort_5000/wrong_port_5000.yaml                                          
         ```                                                                    
                                                                                
         5. Wait for the Pod to become ready (timeout 60s)                      
         ```bash                                                                
         kubectl wait --for=condition=Ready pod/kube-wrong-port-5000            
         --timeout=60s                                                          
         ```                                                                    
                                                                                
