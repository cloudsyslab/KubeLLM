                 try:                                                           
                     self.send_response(200)                                    
                     self.send_header('Content-type', 'text/html')              
                     self.end_headers()                                         
                     message = f"{APP_MESSAGE} (from env var)"                  
                     self.wfile.write(bytes(message, "utf8"))                   
