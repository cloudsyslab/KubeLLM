         into minikube; otherwise build with docker. (This uses the directory   
         containing the Dockerfile as the build context.)                       
         ```bash                                                                
         PROFILE=${MINIKUBE_PROFILE:-$(kubectl config current-context)}         
         if echo "$PROFILE" | grep -qi minikube; then                           
           minikube -p "$PROFILE" image build -t                                
         kube-missing-dependency-app:latest -f                                  
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/missing
         _dependency/Dockerfile                                                 
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/missing
         _dependency                                                            
         else                                                                   
           docker build -t kube-missing-dependency-app:latest -f                
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/missing
         _dependency/Dockerfile                                                 
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/missing
         _dependency                                                            
