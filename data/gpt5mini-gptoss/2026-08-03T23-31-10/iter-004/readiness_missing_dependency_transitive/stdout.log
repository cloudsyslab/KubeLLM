DEBUG    from http.server import HTTPServer, BaseHTTPRequestHandler             
         from helper_config import STATUS_TEXT                                  
                                                                                
         class Handler(BaseHTTPRequestHandler):                                 
             def do_GET(self):                                                  
                 if self.path == "/ready":                                      
