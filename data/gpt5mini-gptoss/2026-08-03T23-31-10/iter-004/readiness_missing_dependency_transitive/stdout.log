                     self.wfile.write(str(STATUS_TEXT).encode())                
                 else:                                                          
                     self.send_response(200)                                    
                     self.end_headers()                                         
                     self.wfile.write(b"ok")                                    
         HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()                 
                                                                                
