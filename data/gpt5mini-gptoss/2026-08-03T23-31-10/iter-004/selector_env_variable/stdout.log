    httpd = HTTPServer(server_address, SimpleHTTPRequestHandler)
    logger.info(f'Server running on {server_address[0]}:{server_address[1]}')
    logger.info(f'APP_MESSAGE: {APP_MESSAGE}')
    httpd.serve_forever()
