         ```bash                                                                
         kubectl delete pod kube-wrong-interface --ignore-not-found && kubectl  
         apply -f                                                               
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/wrong_i
         nterface/wrong_interface.yaml                                          
