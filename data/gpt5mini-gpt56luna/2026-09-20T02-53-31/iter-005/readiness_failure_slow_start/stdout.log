             app: readiness-slow-start-app                                      
         spec:                                                                  
           containers:                                                          
           - name: app                                                          
             image: kube-readiness-slow-start-app:latest                        
             imagePullPolicy: Never                                             
             ports:                                                             
             - containerPort: 8080                                              
             readinessProbe:                                                    
               httpGet:                                                         
                 path: /ready                                                   
                 port: 8080                                                     
               initialDelaySeconds: 5                                           
               periodSeconds: 3                                                 
               timeoutSeconds: 3                                                
               failureThreshold: 1                                              
