                     self.end_headers()                                         
                 elif self.path == "/env":                                      
                     self.send_response(200)                                    
                     self.end_headers()                                         
                     self.wfile.write(f"Running in {mode}".encode())            
                 else:                                                          
                     self.send_response(404)                                    
                     self.end_headers()                                         
                                                                                
         import sys                                                             
                                                                                
         print(f"Running in {mode}", flush=True)                                
         sys.stdout.flush()                                                     
                                                                                
         httpd = HTTPServer(("0.0.0.0", 8765), Handler)                         
         httpd.serve_forever()                                                  
