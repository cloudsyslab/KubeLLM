         import sys                                                             
                                                                                
         mode = os.getenv("APP_MODE")                                           
         if not mode:                                                           
             raise EnvironmentError("Missing required environment variable      
         'APP_MODE'")                                                           
                                                                                
         # Create a simple server                                               
         class Handler(BaseHTTPRequestHandler):                                 
             def do_GET(self):                                                  
                 if self.path == "/":                                           
