         FROM ubuntu:20.04                                                      
                                                                                
         RUN apt-get update && \                                                
             apt-get install -y \                                               
                 python3 \                                                      
                 python3-pip \                                                  
                 python3-venv                                                   
                                                                                
         WORKDIR /app                                                           
                                                                                
         COPY server.py /app                                                    
                                                                                
         EXPOSE 8765                                                            
                                                                                
         CMD ["python3", "server.py"]                                           
                                                                                
         --- server ---                                                         
         import http.server                                                     
         import socketserver                                                    
                                                                                
         Handler = http.server.SimpleHTTPRequestHandler                         
                                                                                
         with socketserver.TCPServer(("0.0.0.0", 8765), Handler) as httpd:      
             print('Serving on port 8765')                                      
             httpd.serve_forever()                                              
                                                                                
