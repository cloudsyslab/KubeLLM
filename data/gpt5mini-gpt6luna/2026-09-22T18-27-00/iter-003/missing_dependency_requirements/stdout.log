         /var/lib/apt/lists/*                                                   
         WORKDIR /app                                                           
         COPY requirements.txt /app/requirements.txt                            
         RUN pip3 install -r /app/requirements.txt                              
         COPY server.py /app/server.py                                          
         EXPOSE 8765                                                            
         CMD ["python3", "server.py"]                                           
                                                                                
         --- deployment manifest ---                                            
         apiVersion: v1                                                         
         kind: Pod                                                              
         metadata:                                                              
           name: kube-missing-dependency-requirements                           
         spec:                                                                  
           containers:                                                          
           - name: kube-missing-dependency-requirements                         
             image: kube-missing-dependency-requirements-app:latest             
             imagePullPolicy: Never                                             
             ports:                                                             
             - containerPort: 8765                                              
                                                                                
