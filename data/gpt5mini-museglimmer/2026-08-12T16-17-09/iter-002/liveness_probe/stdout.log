         kind: Pod                                                              
         metadata:                                                              
           name: kube-liveness                                                  
         spec:                                                                  
           containers:                                                          
           - name: kube-liveness                                                
             image: kube-liveness-app                                           
             imagePullPolicy: Never                                             
             ports:                                                             
                     - containerPort: 8765                                      
             livenessProbe:                                                     
               httpGet:                                                         
                 path: /health                                                  
                 port: 8765                                                     
               initialDelaySeconds: 30                                          
               periodSeconds: 10                                                
         . The file                                                             
         /home/hugov/KubeLLM-Minh/debug_assistant_latest/troubleshooting/livenes
         s_probe/server.py  describes a application. This is the file contents: 
         import time                                                            
         from http.server import SimpleHTTPRequestHandler, HTTPServer           
                                                                                
         time.sleep(2)  # Simulate slow startup                                 
                                                                                
         class Handler(SimpleHTTPRequestHandler):                               
             def do_GET(self):                                                  
                 if self.path == "/health":                                     
                     self.send_response(200)                                    
                     self.end_headers()                                         
                     self.wfile.write(b"OK")                                    
                 else:                                                          
                     self.send_response(404)                                    
                     self.end_headers()                                         
                                                                                
         server = HTTPServer(("0.0.0.0", 8765), Handler)                        
         server.serve_forever()                                                 
         .                                                                      
