OPENAI_API_KEY=your_openai_api_key_here
# Repo code loads .env with override=True so this wins over a stale OPENAI_API_KEY in Windows user env.
# After rotating the key, restart the RAG API server so /add_url/ embeddings pick up the new value.
# When OpenAI returns 429 insufficient_quota (or you prefer local LLMs), run integration tests against Ollama:
# KUBELLM_USE_OLLAMA=1
# Optional overrides (defaults: llama3.2:3b chat, nomic-embed-text embedder):
# KUBELLM_OLLAMA_CHAT_MODEL=llama3.2:3b
# KUBELLM_OLLAMA_EMBEDDER=nomic-embed-text
# Or set per role without KUBELLM_USE_OLLAMA: KUBELLM_API_MODEL, KUBELLM_DEBUG_MODEL, KUBELLM_VERIFICATION_MODEL, KUBELLM_EMBEDDER, KUBELLM_EMBEDDER_PROVIDER
RAG_SERVER_HOST=127.0.0.1
RAG_SERVER_PORT=8000
# Optional: set this only when the runner must talk to a server on another host.
# RAG_API_URL=http://127.0.0.1:8000

# Optional: orchestrator/preflight.sh and collect_diagnostics.sh (bash; export in your shell — not auto-loaded by Python)
# Default Docker Minikube container name is "minikube"; set if you use another container name:
# KUBELLM_MINIKUBE_DOCKER_CONTAINER=minikube
# Default patched kubeconfig output (~/.kube/kubellm-minikube.conf):
# KUBELLM_KUBECONFIG_PATH=${HOME}/.kube/kubellm-minikube.conf
